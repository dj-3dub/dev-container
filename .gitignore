# --- IDE / OS Files ---
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# --- AWS (Security!) ---
# Never commit your keys to GitHub
.aws/
credentials
*.pem

# --- Terraform ---
# Exclude binaries and sensitive state files
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
.terraform.lock.hcl

# --- .NET / C# ---
bin/
obj/
*.user
*.suo
.customeruri
App_Data/

# --- Python ---
__pycache__/
*.py[cod]
*.class
.venv/
venv/
ENV/

# --- Go ---
/go/bin/
/go/pkg/

# --- Monitoring & Data ---
# Exclude the actual database data for Prometheus/Grafana/Arcane
monitoring/prometheus/data/
monitoring/grafana/data/
containers/arcane/data/
jenkins_home/

# --- Logs ---
*.log
